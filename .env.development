# Development build profile — loaded by `wxt --mode development` (the default
# for `npm run dev`).
#
# Override locally with .env.development.local (gitignored).

# Firebase project config (dev project)
VITE_FIREBASE_PROJECT_ID=notehublm-a2490
VITE_FIREBASE_API_KEY=AIzaSyBs4Y8ApZmuYIPpEet1U6VDh-AeDsi7uWM
# authDomain is required to initialize the Firebase Auth SDK in the background.
VITE_FIREBASE_AUTH_DOMAIN=notehublm-a2490.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=notehublm-a2490.appspot.com
# Optional — only consumed if App Check / Analytics is added later. Copy from
# Firebase console → Project settings → your web app's SDK config. Auth and
# Callable Functions work without them.
VITE_FIREBASE_APP_ID=1:253967226446:web:88d9cef8b53cc32161551f
VITE_FIREBASE_MESSAGING_SENDER_ID=253967226446

# Cloud Functions base URL — no trailing slash
# Format: https://us-central1-<project-id>.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_BASE_URL=https://us-central1-notehublm-a2490.cloudfunctions.net

# Origin of the externally hosted auth page embedded by the offscreen iframe.
# Points at the locally running notehub-website dev server.
VITE_EXTERNAL_AUTH_ORIGIN=https://localhost:3000
