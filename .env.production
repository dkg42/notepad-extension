# Production build profile — loaded by `wxt --mode production` (the default
# for `npm run build` and `npm run zip`).
#
# Fill in the prod Firebase project credentials below before shipping, or
# override in .env.production.local (gitignored).

# Firebase project config (prod project — replace with your prod project values)
VITE_FIREBASE_PROJECT_ID=notehublm-prod
VITE_FIREBASE_API_KEY=AIzaSyD7Pcg7F7uY6XNpUykrUtNn17Py1DXi_2U
# authDomain is required to initialize the Firebase Auth SDK in the background.
# Format: <prod-project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=notehublm-prod.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=notehublm-prod.firebasestorage.app
# Optional — only consumed if App Check / Analytics is added later. Auth and
# Callable Functions work without them.
VITE_FIREBASE_APP_ID=1:528666897745:web:84eb32230b5d431ee17770
VITE_FIREBASE_MESSAGING_SENDER_ID=528666897745

# Cloud Functions base URL — no trailing slash
# Format: https://us-central1-<prod-project-id>.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_BASE_URL=https://us-central1-notehublm-prod.cloudfunctions.net

# Origin of the externally hosted auth page embedded by the offscreen iframe.
VITE_EXTERNAL_AUTH_ORIGIN=https://www.notehublm.com
