# Template for build-profile env files. Copy to either:
#   .env.development        — checked-in dev defaults
#   .env.production         — checked-in prod defaults
#   .env.<mode>.local       — local-only overrides (gitignored)
#
# Vite exposes any VITE_-prefixed key to the extension via `import.meta.env`.
# wxt.config.ts additionally reads these via `loadEnv()` to build the manifest.

# Firebase project that signs the user in and issues ID tokens.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=

# Cloud Functions deployment that proxies Google OAuth + Dodo billing.
# Format: https://us-central1-<project-id>.cloudfunctions.net
VITE_CLOUD_FUNCTIONS_BASE_URL=

# Origin of the externally hosted auth page embedded by the offscreen iframe.
# Dev: https://localhost:3000
# Prod: https://www.notehublm.com
VITE_EXTERNAL_AUTH_ORIGIN=
