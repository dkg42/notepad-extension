ile": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L63"}, {"caller_nid": "background_screenshot_handler_cropandcompressdataurl", "callee": "getContext", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L65"}, {"caller_nid": "background_screenshot_handler_cropandcompressdataurl", "callee": "drawImage", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L67"}, {"caller_nid": "background_screenshot_handler_cropandcompressdataurl", "callee": "convertToBlob", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L68"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L88"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "(async () => {\n      const tabs = await chrome.tabs.query({ active: true, currentWindow: true });\n      const tab = tabs[0];\n      if (!tab?.id) return sendResponse({ ok: false, error: 'no_active_tab' });\n\n      if (mode === 'visible') {\n        // Capture directly \u2014 no sidebar close needed.\n        const pngDataUrl = await chrome.tabs.captureVisibleTab(tab.windowId, { format: 'png' });\n        const dataUrl = await compressDataUrl(pngDataUrl);\n        const capture: CaptureRecord = {\n          id: `cap_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,\n          mode: 'visible',\n          dataUrl,\n          tabTitle: tab.title ?? 'Untitled',\n          pageUrl:  tab.url  ?? '',\n          capturedAt: Date.now(),\n        };\n        await screenshotStorage.addCapture(capture);\n        return sendResponse({ ok: true, capture });\n      }\n\n      // Interactive mode \u2014 close sidebar, show overlay on the page.\n      try {\n        await (chrome.sidePanel as unknown as {\n          close: (opts: { windowId: number }) => Promise<void>;\n        }).close({ windowId: tab.windowId });\n      } catch { /* ignore on older Chrome */ }\n\n      const payload = { type: 'SHOW_INTERACTIVE_CAPTURE', mode, windowId: tab.windowId };\n      try {\n        await chrome.tabs.sendMessage(tab.id, payload);\n      } catch {\n        await chrome.scripting.executeScript({\n          target: { tabId: tab.id },\n          files: ['content-scripts/capture-strip.js'],\n        });\n        await new Promise<void>((r) => setTimeout(r, 50));\n        await chrome.tabs.sendMessage(tab.id, payload);\n      }\n\n      sendResponse({ ok: true });\n    })", "is_member_call": false, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L88"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L141"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L141"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "(async () => {\n      const pngDataUrl = await chrome.tabs.captureVisibleTab(sliceWindowId ?? 0, { format: 'png' });\n      return { ok: true, pngDataUrl };\n    })", "is_member_call": false, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L141"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L176"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L176"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "(async () => {\n      const physWidth  = Math.round(viewportWidth * dpr);\n      const physHeight = Math.round(totalScrollHeight * dpr);\n      const canvas = new OffscreenCanvas(physWidth, physHeight);\n      const ctx = canvas.getContext('2d');\n      if (!ctx) throw new Error('Failed to get 2d context from OffscreenCanvas');\n\n      for (const slice of slices) {\n        const blob   = dataUrlToBlob(slice.pngDataUrl);\n        const bitmap = await createImageBitmap(blob);\n        const yOffset = Math.round(slice.scrollY * dpr);\n        ctx.drawImage(bitmap, 0, yOffset);\n        bitmap.close();\n      }\n\n      const jpegBlob = await canvas.convertToBlob({ type: 'image/jpeg', quality: 0.82 });\n      const dataUrl  = await blobToDataUrl(jpegBlob);\n\n      const capture: CaptureRecord = {\n        id: `cap_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,\n        mode: 'scrollable',\n        dataUrl,\n        tabTitle: tabTitle ?? 'Untitled',\n        pageUrl: pageUrl ?? '',\n        capturedAt: Date.now(),\n      };\n\n      await screenshotStorage.addCapture(capture);\n      return { ok: true, capture };\n    })", "is_member_call": false, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L176"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L227"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L227"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "(async () => {\n      const pngDataUrl = await chrome.tabs.captureVisibleTab(captureWindowId ?? 0, {\n        format: 'png',\n      });\n      const dataUrl =\n        cropRect && cropRect.width > 0 && cropRect.height > 0\n          ? await cropAndCompressDataUrl(pngDataUrl, cropRect, devicePixelRatio ?? 1)\n          : await compressDataUrl(pngDataUrl);\n\n      const capture: CaptureRecord = {\n        id: `cap_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,\n        mode,\n        dataUrl,\n        tabTitle: tabTitle ?? 'Untitled',\n        pageUrl: pageUrl ?? '',\n        capturedAt: Date.now(),\n      };\n\n      await screenshotStorage.addCapture(capture);\n      return { ok: true, capture };\n    })", "is_member_call": false, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L227"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L260"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L260"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "(async () => {\n      if (windowId) {\n        await (chrome.sidePanel as unknown as {\n          open: (opts: { windowId: number }) => Promise<void>;\n        }).open({ windowId });\n      }\n      return { ok: true };\n    })", "is_member_call": false, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L260"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L277"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L277"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "getStore", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L277"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L289"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L289"}, {"caller_nid": "background_screenshot_handler_handlescreenshotmessage", "callee": "deleteCapture", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/screenshot-handler.ts", "source_location": "L289"}]}