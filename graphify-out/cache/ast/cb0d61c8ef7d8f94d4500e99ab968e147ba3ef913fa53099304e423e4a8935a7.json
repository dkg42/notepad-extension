-handler.ts", "source_location": "L183"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L203"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L203"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "remove", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L203"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L213"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L213"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "toggleEnabled", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L213"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "catch", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L223"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "callee": "then", "is_member_call": true, "source_file": "/Users/deepak/git-clones/notepad-extension/src/background/pipeline-handler.ts", "source_location": "L223"}, {"caller_nid": "background_pipeline_handler_handlepipelinemessage", "cal